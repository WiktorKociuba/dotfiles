/* Multiply specificity so Matugen always beats zen-themes.css */
:root:root:root {
    /* Core Zen Theme Variables */
    --zen-colors-primary: {{colors.primary.default.hex}} !important;
    --zen-colors-secondary: {{colors.secondary.default.hex}} !important;
    --zen-colors-tertiary: {{colors.tertiary.default.hex}} !important;
    
    --zen-colors-border: transparent !important;
    
    --zen-main-browser-background: {{colors.surface.default.hex}} !important;
    --zen-colors-dialog-background: {{colors.surface_container.default.hex}} !important;
    
    --zen-primary-color: {{colors.primary.default.hex}} !important;
    
    /* Fallback Firefox Variables (just in case) */
    --toolbar-bgcolor: {{colors.surface.default.hex}} !important;
    --toolbar-color: {{colors.on_surface.default.hex}} !important;
    --lwt-sidebar-background-color: {{colors.surface.default.hex}} !important;
    --lwt-sidebar-text-color: {{colors.on_surface.default.hex}} !important;
    --tab-selected-bgcolor: {{colors.primary.default.hex}} !important;
}

/* Force backgrounds on the physical UI elements */
:root:root:root #navigator-toolbox,
:root:root:root #sidebar-box,
:root:root:root #nav-bar,
:root:root:root #main-window {
    background-color: {{colors.surface.default.hex}} !important;
    background-image: none !important;
}