.theme-dark {
    --bg-color: {{colors.primary_container.default.hex | set_lightness: 20.0}};
    --background-primary: {{colors.primary_container.default.hex | set_lightness: 20.0}};
    --background-primary-alt: {{colors.on_primary_container.default.hex | set_lightness: 20.0}};
    --background-secondary: {{colors.on_secondary.default.hex}};
    --background-secondary-alt: {{colors.on_secondary.default.hex}};
    --background-modifier-border: {{colors.outline_variant.default.hex}};
    
    --text-normal: {{colors.on_surface.default.hex}};
    --text-muted: {{colors.on_surface_variant.default.hex}};
    --text-faint: {{colors.outline.default.hex}};
    
    --interactive-accent: {{colors.primary.default.hex}};
    --interactive-accent-hover: {{colors.primary_container.default.hex}};
    
    --text-accent: {{colors.primary.default.hex}};
    --text-accent-hover: {{colors.primary_container.default.hex}};
    
    --scrollbar-bg: {{colors.surface_container_low.default.hex}};
    --scrollbar-thumb-bg: {{colors.outline_variant.default.hex}};
    
    --nav-item-background-active: {{colors.surface_container_high.default.hex}};
    --nav-item-background-hover: {{colors.surface_container_highest.default.hex}};
    
    /* Code blocks and inline styling tags */
    --code-normal: {{colors.secondary.default.hex}};
    --code-background: {{colors.surface_container_high.default.hex}};
}

.theme-light {
    --bg-color: {{colors.surface_container.default.hex}};
    --background-primary: {{colors.surface_container.default.hex}};
    --background-primary-alt: {{colors.surface_container_high.default.hex}};
    --background-secondary: {{colors.surface_container_high.default.hex}};
    --background-secondary-alt: {{colors.surface_container_highest.default.hex}};
    --background-modifier-border: {{colors.outline_variant.default.hex}};
    
    --text-normal: {{colors.on_surface.default.hex}};
    --text-muted: {{colors.on_surface_variant.default.hex}};
    --text-faint: {{colors.outline.default.hex}};
    
    --interactive-accent: {{colors.primary.default.hex}};
    --interactive-accent-hover: {{colors.primary_container.default.hex}};
    
    --text-accent: {{colors.primary.default.hex}};
    --text-accent-hover: {{colors.primary_container.default.hex}};
    
    --scrollbar-bg: {{colors.surface_container_high.default.hex}};
    --scrollbar-thumb-bg: {{colors.outline_variant.default.hex}};
    
    --nav-item-background-active: {{colors.surface_container_low.default.hex}};
    --nav-item-background-hover: {{colors.surface_container_lowest.default.hex}};
    
    --code-normal: {{colors.secondary.default.hex}};
    --code-background: {{colors.surface_container_low.default.hex}};
}
